        </dependency>
        <dependency>
            <groupId>com.yeepay.yop.sdk</groupId>
            <artifactId>yop-java-sdk-crypto-inter</artifactId>
        </dependency>
        <!-- 拉卡拉 SDK 的 notificationHandle(HttpServletRequest) 重载引用 javax.servlet，
             SDK pom 中该依赖为 provided 不向下传递，此处补充仅编译期使用；
             运行期本项目走 body+Authorization 重载，不加载 javax，故不打包、不与 jakarta 冲突 -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>
