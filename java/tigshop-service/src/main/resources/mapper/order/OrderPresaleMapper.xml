<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tigshop.mapper.order.OrderPresaleMapper">

    <resultMap id="BaseResultMap" type="com.tigshop.bean.model.order.OrderPresale">
        <id property="presaleOrderId" column="presale_order_id" jdbcType="INTEGER"/>
        <result property="orderId" column="order_id" jdbcType="INTEGER"/>
        <result property="orderSn" column="order_sn" jdbcType="VARCHAR"/>
        <result property="productId" column="product_id" jdbcType="INTEGER"/>
        <result property="saleMode" column="sale_mode" jdbcType="TINYINT"/>
        <result property="depositAmount" column="deposit_amount" jdbcType="DECIMAL"/>
        <result property="finalPaymentAmount" column="final_payment_amount" jdbcType="DECIMAL"/>
        <result property="depositPaidTime" column="deposit_paid_time" jdbcType="INTEGER"/>
        <result property="finalPaymentStartTime" column="final_payment_start_time" jdbcType="INTEGER"/>
        <result property="finalPaymentPaidTime" column="final_payment_paid_time" jdbcType="INTEGER"/>
        <result property="presaleStatus" column="presale_status" jdbcType="TINYINT"/>
        <result property="deliveryDays" column="delivery_days" jdbcType="SMALLINT"/>
        <result property="deliveryDate" column="delivery_date" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="INTEGER"/>
        <result property="updateTime" column="update_time" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        presale_order_id,order_id,order_sn,product_id,sale_mode,
        deposit_amount,final_payment_amount,deposit_paid_time,final_payment_start_time,
        final_payment_paid_time,presale_status,delivery_days,delivery_date,
        create_time,update_time
    </sql>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM order_presale
        WHERE order_id = #{orderId}
    </select>

    <select id="selectByOrderSn" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM order_presale
        WHERE order_sn = #{orderSn}
    </select>

    <select id="selectWaitingFinalPaymentOrders" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM order_presale
        WHERE presale_status = 1
        AND sale_mode = 2
        AND final_payment_start_time &lt;= #{currentTime}
        ORDER BY final_payment_start_time ASC
    </select>
</mapper>
