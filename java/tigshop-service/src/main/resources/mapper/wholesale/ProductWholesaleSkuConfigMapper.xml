<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tigshop.mapper.wholesale.ProductWholesaleSkuConfigMapper">

    <resultMap id="BaseResultMap" type="com.tigshop.bean.model.wholesale.ProductWholesaleSkuConfig">
        <id     property="id"         column="id"/>
        <result property="productId"  column="product_id"/>
        <result property="skuId"      column="sku_id"/>
        <result property="multiple"   column="multiple"/>
        <result property="isDelete"   column="is_delete"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, product_id, sku_id, multiple,
        is_delete, create_time, update_time
    </sql>

    <!-- 列出某商品全部未删除的 SKU 配置 -->
    <select id="listByProductId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product_wholesale_sku_config
        WHERE is_delete = 0
          AND product_id = #{productId}
    </select>

    <!-- 批量取 SPU 兜底(sku_id=0)倍数：CR-20260613-0943 C 端列表卡片 wholesaleMultiple 回填 -->
    <!-- CR-20260615-0911：去掉 sku_id=0 过滤，取全部未删配置行；
         由 resolveSpuMultipleMap 按「sku_id=0 优先 → 否则 min(multiple>1)」聚合（兼容倍数存真实 SKU）。 -->
    <select id="selectSpuConfigByProductIds" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product_wholesale_sku_config
        WHERE is_delete = 0
          AND product_id IN
        <foreach collection="productIds" item="pid" open="(" separator="," close=")">
            #{pid}
        </foreach>
    </select>

    <!-- 物理删除：绕开 @TableLogic 软删改写；与 config/price 物理删策略一致 -->
    <delete id="hardDeleteByProductIds">
        DELETE FROM product_wholesale_sku_config
         WHERE product_id IN
         <foreach collection="productIds" item="pid" open="(" separator="," close=")">
             #{pid}
         </foreach>
    </delete>

</mapper>
