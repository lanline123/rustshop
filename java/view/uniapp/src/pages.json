            },
            {
                "pagePath": "pages/member/index"
            }
        ]
    },
    "preloadRule": {
        "pages/index/index": {
            "network": "all",
            "packages": [
                "pages/product",
                "pages/order",
                "pages/user"
            ]
        },
        "pages/cart/index": {
            "network": "all",
            "packages": ["pages/order", "pages/address"]
        },
        "pages/member/index": {
            "network": "all",
            "packages": ["pages/user", "pages/order", "pages/address"]
        }
    },
    "globalStyle": {
        "backgroundTextStyle": "dark",
        "navigationBarBackgroundColor": "#fff",
        "navigationBarTextStyle": "black",
        "navigationStyle": "custom",
        "navigationBarTitleText": "",
        "app-plus": {
            "bounce": "none"
        }
    },
    "easycom": {
        "autoscan": true,
        "custom": {
            "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue",
            "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
            "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
            "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue",
            "tig-(.*)": "@/components/tig/tig-$1/tig-$1.vue",
            "format-price": "@/components/format-price/format-price.vue",
            "loading-box": "@/components/loading-box/loading-box.vue",
            "empty-box": "@/components/empty-box/empty-box.vue"
        }
    }
}
